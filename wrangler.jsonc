// Cloudflare Workers 배포 설정 — Workers Builds 가 빌드(npm run check) 뒤 `npx wrangler deploy` 로 읽습니다.
// 스크립트 없이 dist/ 의 정적 파일만 올리는 Worker 입니다. 사용자 도메인은 Cloudflare 대시보드에서 연결합니다.
// wrangler 는 package.json 에 정확한 버전으로 고정해 두어, 배포 동작이 Cloudflare 의 새 릴리스에 따라 바뀌지 않습니다.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 대시보드의 Worker 이름과 같아야 합니다
  "name": "mobile-wedding-invitation",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    // 없는 주소(/foo/ 등)에도 청첩장을 돌려줍니다. 그래서 자산·사진 경로는 / 로 시작합니다 (vite.config.ts 의 base)
    "not_found_handling": "single-page-application",
    // /index.html 은 / 로 보냅니다 (기본값을 적어 둔 것)
    "html_handling": "auto-trailing-slash"
  }
}
