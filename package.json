{
  "name": "mobile-wedding-invitation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "og": "node scripts/make-og.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "fonts": "node scripts/subset-font.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:maps": "node scripts/check-maps.mjs",
    "check:photos": "node scripts/check-photo-framing.mjs && node scripts/check-photo-zoom.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:content && npm run check:maps && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.0",
    "eslint": "^10.9.1",
    "fontkit": "^2.0.4",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "wrangler": "4.145.0"
  }
}
